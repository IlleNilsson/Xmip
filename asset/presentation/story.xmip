[[section]]
title = "Xmip in one view"
headline = "Connect systems\nRecord responsibility"
screen = """\
Business continuity and infrastructure choice\nTOML configuration and VS \
Code design\nHealth, Messages, Journeys and recovery\
"""
voice = "female"
power = "both"
narration = """\
Xmip brings the story together: connect systems under your control, define \
the exchange in readable configuration, and follow its recorded outcome. \
Leaders assess business continuity and infrastructure choice. Developers \
work in TOML and Visual Studio Code. Operators follow health, messages and \
journeys to investigate and recover the exchange. That is the platform \
this project is building.\
"""
sources = [
  "README.md",
  "doc/getting-started.md"
]
note = ""
layout = [
  "closing",
  "Xmip connects systems\nand records responsibility",
  "Design the exchange.\nRun it. Follow its outcome.",
