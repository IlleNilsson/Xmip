[[section]]
title = "Offline by design"
headline = "Internet access is a choice"
screen = """\
Prepare packages, deploy locally\nNo hosted control-plane \
dependency\nExplicit online capability\
"""
voice = "female"
power = false
narration = """\
Offline operation is part of Xmip’s design. Packages can be prepared where \
dependencies are reachable, then brought into disconnected environments. \
Internet access is an explicit capability, supporting sites where \
connectivity is restricted, intermittent or deliberately absent.\
"""
sources = [
  "doc/decision/ADR-0045-offline-is-the-default.md",
  "README.md"
]
note = ""
layout = [
  "journey",
  "Offline by design",
  [
    [
      "01",
      "Prepare",
      "Build packages where dependencies are available."
