[[section]]
title = "Open source"
headline = "Freedom to inspect and extend"
screen = """\
AGPL-3.0-or-later\nStudy, contribute and extend\nExplicit interfaces for \
specialist providers\
"""
voice = "female"
power = true
narration = """\
Open source is a flex moment because teams can inspect, improve and extend \
Xmip. The platform is licensed under the GNU Affero General Public \
License, version three or later. Recorded architecture and explicit \
capability interfaces support that freedom. Independent modules loaded \
across the documented boundary can use their publisher’s chosen license.\
"""
sources = [
  "CONTRIBUTING.md",
  "doc/decision/ADR-0061-a-provider-builds-against-the-sdk.md"
]
note = "AGPL-3.0-or-later"
