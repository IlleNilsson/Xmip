]

[[section]]
title = "An order through Xmip"
headline = "One business exchange, visible responsibility"
screen = """\
Sales system → Receive Location\nMessage → Subscription → Journey\nSend \
Location → Warehouse\
"""
voice = "female"
power = false
narration = """\
Consider an illustrative order travelling from a sales system to a \
warehouse. A Receive Location accepts the stream, and Xmip persists a \
message. Matching subscriptions open journeys to the destinations that \
want it. A Send Location attempts delivery to the warehouse. That journey \
gives an interrupted exchange a place and an outcome to investigate.\
"""
sources = [
  "README.md",
  "doc/terminology.md"
]
note = "Illustrative business flow"
layout = [
  "journey",
  "An order through Xmip",
  [
    [
      "01",
      "Receive",
      "A sales system hands a Stream to a Receive Location."
    ],
    [
      "02",
      "Accept and route",
      "Xmip persists a Message. Matching Subscriptions open Journeys."
    ],
    [
      "03",
      "Deliver",
      "A Send Location carries the order to the warehouse."
    ]
  ],
  """\
Illustrative order flow. Each destination has a Journey with its own \
progress and outcome.\
"""
]

[[section]]
title = "Acceptance and accountability"
headline = "A clear handover of responsibility"
screen = """\
Before acceptance: sender responsibility\nAfter acceptance: a persisted \
Message\nRefusal and failure remain distinct\
"""
voice = "male"
power = false
narration = """\
Acceptance is the handover of responsibility. Before it, the sender owns \
the stream. After it, Xmip persists a message and records its progress. \
Keeping refusal distinct from a later delivery failure helps both \
organizations understand which side should act next.\
"""
sources = [
  "README.md",
  "doc/architecture/estate-map.md"
]
note = ""
layout = [
  "split",
  "The acceptance boundary",
  [
    [
      "Before acceptance",
      "Sender responsibility",
      """\
The Stream belongs to its sender. A refused arrival has not become Xmip’s \
responsibility.\
"""
    ],
    [
      "After acceptance",
      "Persisted Message",
      """\
Xmip records the accepted content and its progress through the platform.\
"""
    ]
  ],
  "A refusal and a later delivery failure call for different actions."
]

[[section]]
title = "Subscriptions and routing"
headline = "Publish once, match each destination"
screen = """\
Context values select destinations\nOne Journey per matching \
Subscription\nPause, hold and resume deliberately\
"""
voice = "female"
power = false
narration = """\
A subscription expresses which messages a destination wants. Each match \
opens a journey, while an unmatched message remains available for replay. \
Operators can pause a subscription without discarding its work, then \
resume the held messages in the order they arrived.\
"""
sources = [
  "doc/architecture/estate-map.md",
  "doc/decision/ADR-0013-journey-model.md"
]
note = ""
layout = [
  "rows",
  "Subscriptions and routing",
  [
    [
      "Match",
      """\
Context values select a Send Port, Send Port Group or Work Process. Each \
match opens a Journey.\
"""
    ],
    [
      "Hold",
      """\
A paused Subscription keeps matching work. Resume picks it up oldest \
first.\
"""
    ],
    [
      "Replay",
      """\
An unmatched Message remains in the Dead Message Queue until routing is \
corrected and it is replayed.\
"""
    ]
  ]
]

[[section]]
title = "Recovery and delivery"
headline = "An outcome you can act on"
screen = """\
Completed, Failed or Dismissed\nConfigured retry and backoff\nReplay \
routing issues; retry delivery failures\
"""
voice = "male"
power = false
narration = """\
Recovery starts with the outcome. A routing issue calls for correction and \
replay. A failed delivery calls for investigation and retry, or an \
intentional dismissal. Xmip keeps those actions distinct, while configured \
attempts and backoff handle repeated delivery attempts.\
"""
sources = [
  "doc/architecture/estate-map.md",
  "doc/decision/ADR-0013-journey-model.md"
]
note = ""
layout = [
  "rows",
  "Recovery follows the outcome",
  [
    [
      "Unmatched",
      "Correct the routing, then replay the Message."
    ],
    [
      "Failed delivery",
      """\
Inspect the Journey and retry, following configured attempts and backoff.\
"""
    ],
    [
      "Deliberate stop",
      """\
Dismiss intentionally. Completed, Failed and Dismissed remain distinct \
outcomes.\
"""
    ]
  ]
]

[[section]]
title = "Applications and bindings"
headline = "Design the integration once"
screen = """\
Application: integration intent\nBinding: placement and addresses\nOne \
design across deployment environments\
"""
voice = "female"
power = false
narration = """\
An Xmip Application describes the integration itself. A binding places \
that application on a node and supplies its environment. This separation \
lets developers reason about the business exchange while deployment \
choices determine which systems, addresses and machines participate.\
"""
sources = [
  "doc/decision/ADR-0064-developers-design-in-vs-code.md"
]
note = ""
layout = [
  "split",
  "Application and binding",
  [
    [
      "Application",
      "What the integration does",
      """\
Receive Ports, Subscriptions, Send Ports and Work Processes describe the \
exchange.\
"""
    ],
    [
      "Binding",
      "Where it runs",
      """\
A node selects the Application and supplies its deployment context and \
addresses.\
"""
    ]
  ],
  "The integration’s intent stays separate from its machines and endpoints."
]

