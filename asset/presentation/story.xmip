[[section]]
title = "Health and investigation"
headline = "From the cluster to the cause"
screen = """\
Fine or Holding at parent scopes\nDrill into the affected resource\nWords \
and reasons guide action\
"""
voice = "male"
power = false
narration = """\
Health should tell an operator where to look and what to do. Xmip uses \
named conditions and scope navigation. A parent holding points into its \
children, where the affected resource and its reason help distinguish a \
deliberate pause from strain or failure.\
"""
sources = [
  "doc/decision/ADR-0041-health-is-a-mood-and-does-not-propagate.md"
]
note = ""
layout = [
  "journey",
  "From health to the cause",
