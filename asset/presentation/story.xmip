# Shared editorial source for both formats; TOML inside.
version = 1
language = "en"
pronunciation = "Smip"
brand_lime = "#75c93b"
logo = "asset/brand/xmip-logo.png"
frame_width = 1280
frame_height = 720
frames_per_second = 24
voice_delay_seconds = 0.5
scene_padding_seconds = 2

[[section]]
title = "Xmip"
headline = "Messaging and integration\nUnder your control"
screen = "Messaging and integration\nFor leaders, developers and operators"
voice = "female"
power = "both"
narration = """\
Welcome to Xmip, an open-source messaging and integration platform written \
in Rust. It is on premises first and cloud installable, so organizations \
choose where their integration runs. This is the Xmip project story: what \
it connects, how it records responsibility, and how people design and \
operate it.\
"""
sources = [
  "README.md",
  "CONTRIBUTING.md"
]
note = "Xmip Continuum · Project overview"
layout = [
  "cover",
  "Messaging and integration\nUnder your control"
]

[[section]]
title = "Xmip’s purpose"
headline = "Messaging and integration\nIn your own estate"
screen = """\
On-premises first\nCloud-installable\nFamiliar integration concepts, \
modular foundations\
"""
voice = "male"
power = false
narration = """\
Xmip is being developed for organizations that need dependable messaging \
and integration under their own control. It carries forward familiar \
integration concepts while putting deployment and data under \
organizational control. Its central promise is accountability: once a \
message is accepted, its journey and outcome give operators evidence they \
can act on.\
"""
sources = [
  "README.md",
  "doc/planning/market-position.md"
]
note = ""
layout = [
  "three",
  "Xmip’s purpose",
  [
    [
      "Organizational control",
      "On premises first",
      """\
Connect systems in your own estate, with cloud installation when you \
choose.\
"""
    ],
    [
      "Integration continuity",
      "Familiar concepts",
      """\
Receive Locations, Send Ports and Work Processes carry integration \
knowledge forward.\
"""
    ],
    [
      "Accountability",
      "Keep the evidence",
      """\
Accepted Messages, their Journeys and recorded outcomes make failures \
investigable.\
"""
    ]
  ],
  """\
Open-source Rust platform. No hosted control-plane dependency. Offline \
operation by design.\
"""
]

[[section]]
title = "For the CEO"
headline = "Business continuity and freedom to choose"
screen = """\
Understand the business exchange\nKeep deployment choices open\nEvaluate \
value in a real flow\
"""
voice = "female"
power = false
narration = """\
For a CEO, the question is what happens to the business when a system \
exchange stops. Xmip focuses on accountable outcomes, recovery and \
organizational choice. A practical evaluation connects those principles to \
a real process, its owner and its business impact.\
"""
sources = [
  "README.md"
]
note = ""
layout = [
  "split",
  "For the CEO",
  [
    [
      "Business continuity",
      "Keep the exchange moving",
      """\
Understand an interruption, identify responsibility and recover the \
business flow.\
"""
    ],
    [
      "Freedom to choose",
      "Keep your options open",
      """\
Control deployment and assess an open implementation against your \
organization’s needs.\
"""
    ]
  ],
  "Evaluate value through one real exchange and its business owner."
]

[[section]]
title = "For the CIO"
headline = "Control of infrastructure and data"
screen = """\
Choose where integration runs\nReview source and architecture\nKeep \
infrastructure decisions in-house\
"""
voice = "male"
power = false
narration = """\
For a CIO, Xmip keeps infrastructure decisions within the organization. \
Nodes can be placed close to systems, at remote sites or on chosen hosting \
infrastructure. Open implementation and recorded architecture make it \
possible to assess the platform and understand how it evolves.\
"""
sources = [
