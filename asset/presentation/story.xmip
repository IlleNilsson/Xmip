    [
      "01",
      "Cluster",
      "Fine or Holding gives the first direction."
    ],
    [
      "02",
      "Affected scope",
      "Holding tells the operator to drill into the children."
    ],
    [
      "03",
      "Resource and reason",
      "Distinguish a pause, active work, strain or a blocked resource."
    ]
  ],
  "Health uses words that describe the situation and guide investigation."
]

[[section]]
title = "Audit and evidence"
headline = "Understand what happened over time"
screen = """\
Observation: current activity\nAudit: actions and outcomes over \
time\nChained records with verification\
"""
voice = "female"
power = false
narration = """\
Current observation and audit answer different questions. Observation \
shows what is happening now. Audit records actions and outcomes over time. \
Chained program records, verification and journey evidence help the team \
investigate a specific exchange instead of guessing from disconnected \
symptoms.\
"""
sources = [
  "doc/architecture/estate-map.md",
  "doc/decision/README.md"
]
note = ""
layout = [
  "split",
  "Observation and audit",
  [
    [
      "Observation",
      "What is happening now",
      "Current activity and health direct attention to the affected scope."
    ],
    [
      "Audit",
      "What happened over time",
      """\
Shared program audit, chained records and verification preserve the \
recorded sequence.\
"""
    ]
  ],
  "Use Messages and Journeys to investigate a specific exchange."
]

