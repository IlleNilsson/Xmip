[[section]]
title = "Work Processes"
headline = "Business flow with durable state"
screen = """\
Step-by-step business flow\nBPMN designs compile to Work Process \
units\nExecution state belongs to the Ledger\
"""
voice = "female"
power = false
narration = """\
Some exchanges need business steps as well as delivery. Xmip models these \
as Work Processes, designed in BPMN and compiled into executable units. \
Their state belongs to the ledger, so waiting work does not hold a thread. \
Compilation and execution exist as components; connecting them into the \
assembled service remains a project milestone.\
"""
sources = [
  "doc/architecture/estate-map.md",
  """\
doc/decision/ADR-0066-routes-are-configured-transforms-and-processes-are-compiled.md\
"""
]
note = "Components built; assembled-service integration ahead"
layout = [
  "journey",
  "Work Processes",
  [
    [
      "01",
      "Define",
      "Describe business steps in a BPMN design."
    ],
    [
      "02",
      "Compile",
      "Turn the design into a Work Process unit."
    ],
    [
      "03",
      "Run and wait",
      "Produce a Message, finish without one or wait for something named."
    ]
  ],
  """\
BPMN compilation and execution exist as components; integration into the \
assembled service is a project milestone.\
"""
]

[[section]]
title = "A modular foundation"
headline = "Independent capabilities, explicit boundaries"
screen = """\
Separate transport, content and processing\nVersioned C ABI at module \
boundaries\nExtend the capability your system needs\
"""
voice = "male"
power = false
narration = """\
Xmip separates how data travels, how it is represented, and what the \
integration does with it. Contracts define acceptance rules, while \
processing expresses business flow. Providers extend individual \
capabilities through explicit interfaces and a versioned C boundary. That \
modular architecture lets the platform evolve without treating every \
change as a replacement.\
"""
sources = [
  "doc/decision/ADR-0012-module-boundary.md",
  "doc/decision/ADR-0010-contract-transport-repository-boundaries.md",
  "doc/decision/ADR-0061-a-provider-builds-against-the-sdk.md"
]
note = ""
layout = [
  "three",
  "Independent capabilities",
  [
    [
      "Transport",
      "How data travels",
      "Move data without deciding what its content means."
    ],
    [
      "Content and Contracts",
      "What the data means",
      """\
Represent data and define acceptance rules independently of transport.\
"""
    ],
    [
      "Processing",
      "What happens next",
      """\
Route Messages and express business flow through defined capabilities.\
"""
    ]
  ],
  "A versioned C ABI specifies module ownership, lifetimes and errors."
]

[[section]]
title = "The technology estate"
headline = "From business systems to the edge"
screen = """\
Files and file transfer\nWeb, brokers and databases\nIndustrial and edge \
communication\
"""
voice = "female"
power = false
narration = """\
Xmip’s technology estate spans file transfer, web communication, message \
brokers, databases and industrial systems. SFTP, HTTP, AMQP, Kafka, \
PostgreSQL and OPC UA are examples of that scope. A site build chooses the \
technologies it needs. This is the estate’s breadth, with availability \
depending on the capability and its integration into the service.\
"""
sources = [
  "doc/architecture/estate-map.md"
]
note = "Technology estate; capability availability varies"
layout = [
  "catalog",
  "Across the technology estate",
  [
