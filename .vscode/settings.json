{
    // The estate is 43 submodules. VS Code stops detecting them at 10 by
    // default and says nothing about it, so the Source Control view shows an
    // apparently arbitrary subset while the rest are present on disk, in
    // .gitmodules and in HEAD. Nothing errors, which is why it reads as
    // repositories going missing rather than as a setting.
    //
    // Raised well above the current count so adding the next module does not
    // bring the same silence back.
    "git.detectSubmodules": true,
    "git.detectSubmodulesLimit": 100,

    "git.openRepositoryInParentFolders": "never",
    "git.repositoryScanMaxDepth": 4,
    "scm.alwaysShowRepositories": true,

    // 43 repositories times target/ is a large number of files nobody wants
    // watched, indexed, or offered in Quick Open. The working areas hold the
    // shared build directory (.ai-interaction/target-windows) and whole
    // clones of the estate (.local-work/*-work): watched, a build sent the
    // C/C++ extension 74,000 file events and crashed its language server
    // (microsoft/vscode-cpptools#14841, 2026-10-22).
    "files.watcherExclude": {
        "**/target/**": true,
        "**/target-*/**": true,
        "**/bin/**": true,
        "**/obj/**": true,
        "**/.ai-interaction/**": true,
        "**/.local-work/**": true
    },
    "search.exclude": {
        "**/target": true,
        "**/target-*": true,
        "**/bin": true,
        "**/obj": true,
        "**/.ai-interaction": true,
        "**/.local-work": true
    },
    "C_Cpp.files.exclude": {
        "**/target/**": true,
        "**/target-*/**": true,
        "**/.ai-interaction/**": true,
        "**/.local-work/**": true
    },

    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
