data/
**/data/
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
persistence-rocksdb/
**/persistence-rocksdb/
management.sqlite

# Local inbound/outbound test folders
/inbound/
/outbound/
/tmp/
/temp/
tmp/
temp/

# Environment and local settings
.env
.env.*
*.local

# Sibling Xmip repositories, if anyone clones them here anyway.
# Xmip-Git clones beside this repository, not into it, but a wrong
# -DestinationPath should not be able to put thirty repositories into your
# working tree unnoticed.
xmip-repositories/
**/xmip-repositories/

# Editors and IDEs
#
# .vscode/settings.json is the exception and is committed on purpose. The estate
# is 43 submodules and VS Code stops detecting them at 10 by default, silently —
# no error, no warning, the repositories simply are not in the Source Control
# view. A setting every person has to discover for themselves is a setting most
# of them will not have.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
**/logs/

# Generated by Sync-XmipEstate -Report. A snapshot of one moment, wrong from
# the next run onwards. Named .ai-work by the owner's ruling of 2026-08-31:
# machine-generated working output carries the ai- prefix, whichever machinery
# wrote it. Assistant session residue is .ai-interaction/ below.
.ai-work/

# This device's working state: what building or running Xmip HERE needs and no
# other machine should ever see — a target choice, a local node configuration,
# build preferences. Reserved 2026-08-31 before anything writes it, so the
# first thing that does has a home instead of inventing one.
.local-work/

# Assistant working area: logs, run scripts, scratch. Deliberately untracked —
# an AI's operational residue is not the estate's history, and the estate's
# history is not its scratchpad. The convention lives in CLAUDE.md.
.ai-interaction/
