# A site: a hospital's interface engine on its own server, taking HL7 v2
# over MLLP from the clinical systems and FHIR over HTTP from the new ones,
# and delivering both onward (ADR-0015, amendment 2026-10-01).
# Build-XmipService -Site hospital-interface turns it into a build; the
# node's TOML then picks, at run time, from what the build made possible.

description = "A hospital's interface engine: HL7 v2 over MLLP, FHIR over HTTP."

target = "server"

# One server, so it keeps Xmip Storage itself: a one-machine node carries
# the Storage role (the owner, 2026-10-20; ADR-0056, amendment 2026-10-20).
roles = ["executing", "operational", "monitoring", "storage"]

# The technologies this deployment chose, by repository name (ADR-0015,
# amendment 2026-10-19).
technologies = [
  "xmip-core-transport-mllp",
  "xmip-core-transport-tcp",
  "xmip-core-message-hl7-er7",
  "xmip-core-contract-hl7-v2",
  "xmip-core-transport-http",
  "xmip-core-contract-fhir",
]
