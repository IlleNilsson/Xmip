# A site: a gateway on a factory floor, reading the machines over Modbus and
# OPC UA and publishing what they say to the plant's MQTT broker
# (ADR-0015, amendment 2026-10-01). Build-XmipService -Site factory-gateway
# turns it into a build; the node's TOML then picks, at run time, from what
# the build made possible.

description = "A factory floor gateway: Modbus and OPC UA in, MQTT out."

target = "edge"

# One machine, so it keeps Xmip Storage itself: a one-machine node carries
# the Storage role (the owner, 2026-10-20; ADR-0056, amendment 2026-10-20).
roles = ["executing", "storage"]

# The technologies this deployment chose, by repository name (ADR-0015,
# amendment 2026-10-19).
technologies = [
  "xmip-core-transport-modbus",
  "xmip-core-transport-opc-ua",
  "xmip-core-transport-mqtt",
]
