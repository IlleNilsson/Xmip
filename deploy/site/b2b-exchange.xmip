# A site: a hosted node trading with other businesses, receiving EDI over AS2
# and SFTP and sending it on to a managed queue and storage (ADR-0015,
# amendment 2026-10-01). Build-XmipService -Site b2b-exchange turns it into
# a build; the node's TOML then picks, at run time, from what the build made
# possible.

description = "A hosted business-to-business exchange: EDI over AS2 and SFTP."

target = "hosted"

# One hosted node, and the site the Ansible role builds by default
# (deploy/dsc/ansible), so it keeps Xmip Storage itself: a one-machine node
# carries the Storage role (the owner, 2026-10-20; ADR-0056, amendment
# 2026-10-20).
roles = ["receiving", "sending", "operational", "storage"]

# The technologies this deployment chose, by repository name (ADR-0015,
# amendment 2026-10-19).
technologies = [
  "xmip-core-transport-as2",
  "xmip-core-transport-sftp",
  "xmip-core-message-edi-x12",
  "xmip-core-contract-edi-x12",
  "xmip-core-message-edi-edifact",
  "xmip-core-contract-edi-edifact",
  "xmip-core-transport-aws-sqs",
  "xmip-core-transport-s3",
]
