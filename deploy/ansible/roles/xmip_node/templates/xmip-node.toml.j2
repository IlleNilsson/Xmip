# The node configuration xmip-core-configure reads
# (module/platform/configure/doc/node-configuration.md). What the reader has
# a default for is left to it: the data directory is the `data` beside this
# file's `config`, and the runtime store is RocksDB there, sealed by the
# platform's key store (ADR-0018, amendment 2026-09-30).
[service]
name = "{{ xmip_service_name }}"
cluster_name = "{{ xmip_cluster_name }}"
node_name = "{{ xmip_node_name }}"
# ADR-0045: a node may assume no route to the internet unless the operator
# says so; nothing at runtime reaches out.
online = {{ xmip_online | lower }}
