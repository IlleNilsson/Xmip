{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Xmip.Node/Service",
  "version": "0.1.0",
  "description": "The node's systemd unit running and started with the machine.",
  "tags": [
    "Xmip"
  ],
  "get": {
    "executable": "pwsh",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-File",
      "./node.resource.ps1",
      "-Kind",
      "Service",
      "-Operation",
      "get"
    ],
    "input": "stdin"
  },
  "test": {
    "executable": "pwsh",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-File",
      "./node.resource.ps1",
      "-Kind",
      "Service",
      "-Operation",
      "test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "set": {
    "executable": "pwsh",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-File",
      "./node.resource.ps1",
      "-Kind",
      "Service",
      "-Operation",
      "set"
    ],
    "input": "stdin",
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "1": "Error"
  },
  "schema": {
    "embedded": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "The unit, xmip-<node>.",
          "type": "string"
        },
        "_exist": {
          "type": "boolean",
          "readOnly": true
        },
        "_inDesiredState": {
          "type": "boolean",
          "readOnly": true
        }
      }
    }
  }
}
