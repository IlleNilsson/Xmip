{
  "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
  "type": "Xmip.Node/Opening",
  "version": "0.1.0",
  "description": "A firewall opening for each port xmip-service --listening says the node's configuration listens on, and no other.",
  "tags": [
    "Xmip"
  ],
  "get": {
    "executable": "pwsh",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-File",
      "./node.resource.ps1",
      "-Kind",
      "Opening",
      "-Operation",
      "get"
    ],
    "input": "stdin"
  },
  "test": {
    "executable": "pwsh",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-File",
      "./node.resource.ps1",
      "-Kind",
      "Opening",
      "-Operation",
      "test"
    ],
    "input": "stdin",
    "return": "state"
  },
  "set": {
    "executable": "pwsh",
    "args": [
      "-NoLogo",
      "-NonInteractive",
      "-NoProfile",
      "-File",
      "./node.resource.ps1",
      "-Kind",
      "Opening",
      "-Operation",
      "set"
    ],
    "input": "stdin",
    "implementsPretest": true,
    "return": "state"
  },
  "exitCodes": {
    "0": "Success",
    "1": "Error"
  },
  "schema": {
    "embedded": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "program",
        "configuration",
        "node"
      ],
      "properties": {
        "program": {
          "description": "xmip-service, as the package installed it.",
          "type": "string"
        },
        "configuration": {
          "description": "The node's xmip-node.toml.",
          "type": "string"
        },
        "node": {
          "description": "The node this machine is.",
          "type": "string"
        },
        "ports": {
          "readOnly": true,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "_exist": {
          "type": "boolean",
          "readOnly": true
        },
        "_inDesiredState": {
          "type": "boolean",
          "readOnly": true
        }
      }
    }
  }
}
